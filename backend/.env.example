# ── Core ──────────────────────────────────────────────
# DEBUG=False turns on Secure cookies and HSTS, and enables the production
# config check that refuses to start if anything below is still a placeholder.
DEBUG=True

# openssl rand -hex 32
# Rotating this invalidates every session and every pending reset link.
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32

# SQLite for local dev; PostgreSQL in production.
#   postgresql+asyncpg://user:password@host:5432/novalabs
DATABASE_URL=sqlite+aiosqlite:///./novalabs.db

# Password-reset links are built from this — must be the real domain in prod.
FRONTEND_URL=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────
# True ONLY behind a proxy that sets X-Forwarded-For (nginx, Cloudflare, Vercel).
# Launch uvicorn to match:
#   no proxy    -> uvicorn app.main:app --no-proxy-headers
#   with proxy  -> uvicorn app.main:app --forwarded-allow-ips="<proxy-ip>"
# Getting this wrong lets clients forge their IP and bypass every rate limit.
TRUST_PROXY_HEADERS=False
SECURITY_HEADERS_ENABLED=True

LOGIN_RATE_LIMIT=5
SIGNUP_RATE_LIMIT_PER_HOUR=10
CODE_EXEC_RATE_LIMIT_PER_HOUR=60
AI_ANALYSIS_RATE_LIMIT_PER_DAY=5

# ── Razorpay ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# From the Razorpay dashboard after creating the webhook. Without it, payment
# confirmations cannot be verified and can be forged.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Email ─────────────────────────────────────────────
# A new Resend account can only send to the account owner. Until a domain is
# verified at resend.com/domains, password resets and signup codes are dropped
# for everyone else — and the API still returns success either way.
RESEND_API_KEY=
EMAIL_FROM=NOVA LABS <onboarding@resend.dev>

# ── Storage ───────────────────────────────────────────
# Without these, uploads go to local disk and are lost on redeploy.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Integrations ──────────────────────────────────────
# Web OAuth client ID. The mobile app passes this same value as
# GOOGLE_SERVER_CLIENT_ID so the ID token audience matches.
GOOGLE_CLIENT_ID=
GITHUB_TOKEN=
WANDBOX_URL=https://wandbox.org/api

# ── Web Push (VAPID) ──────────────────────────────────
# Generate a pair locally, no third-party account required:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys()"
# Without these the subscribe endpoint returns 503 and nothing is pushed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
