# Base URL of the FastAPI backend (used by the browser and the /api/* rewrite)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin. Drives canonical tags, OG URLs, sitemap and robots.
# Leave unset on Vercel to fall back to the project's production URL.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
